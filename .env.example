# Variables de entorno del proyecto. Copia este archivo a .env.local para trabajar en local
# (.env.local NO se sube a git). En Vercel se ponen en Project -> Settings -> Environment Variables.

# --- Base de datos (Postgres) ------------------------------------------------
# En Vercel la crea la integración de Neon (Storage -> Create Database -> Neon) y pone estas variables sola.
# Sin DATABASE_URL la web pública sigue funcionando con los datos de lib/data/* y el panel avisa de que falta.
DATABASE_URL=postgres://usuario:contraseña@host/basedatos?sslmode=require

# --- Panel de administración (admin.covegarage.com) ---------------------------
# Clave para firmar las sesiones: texto aleatorio de 32 caracteres o más (si se cambia, se cierran todas las sesiones).
ADMIN_SESSION_SECRET=
# Código de un solo uso para crear el primer acceso en /login. Cuando ya exista tu usuario, se puede borrar.
ADMIN_SETUP_TOKEN=

# --- Fotos de los coches subidas desde el panel -------------------------------
# En Vercel la crea Storage -> Create -> Blob y pone BLOB_READ_WRITE_TOKEN sola. En local no hace falta
# (las fotos se guardan en public/uploads, que no se sube a git).
BLOB_READ_WRITE_TOKEN=
