# Variables de entorno del proyecto. Copia este archivo a .env.local para trabajar en local
# (.env.local NO se sube a git). En Vercel se ponen en Project -> Settings -> Environment Variables.

# --- Base de datos (Postgres en Supabase) ------------------------------------
# Supabase -> botón "Connect" -> "Transaction pooler" -> copiar la cadena (puerto 6543) y poner la contraseña de la base
# de datos donde dice [YOUR-PASSWORD]. Hay que usar la del POOLER (la conexión directa de Supabase no funciona desde Vercel).
# Sin DATABASE_URL la web pública sigue funcionando con los datos de lib/data/* y el panel avisa de que falta.
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Fotos de los coches subidas desde el panel (Supabase Storage) -------------
# Supabase -> Project Settings -> Data API: la "Project URL"; y en API Keys la clave secreta ("secret", empieza por
# sb_secret_…) o, en proyectos antiguos, la "service_role". NUNCA con prefijo NEXT_PUBLIC_: es una clave de servidor.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del almacén público de fotos (se crea solo la primera vez). Opcional; por defecto "coches".
SUPABASE_STORAGE_BUCKET=coches
# (Alternativa si algún día se usa Vercel Blob en vez de Supabase: BLOB_READ_WRITE_TOKEN. En local no hace falta nada:
#  las fotos se guardan en public/uploads, que no se sube a git.)

# --- Panel de administración (admin.covegarage.com) ---------------------------
# Código de un solo uso para crear el primer acceso en /login. Cuando ya exista tu usuario, se puede borrar.
ADMIN_SETUP_TOKEN=
# Clave para firmar las sesiones (opcional): texto aleatorio de 32 caracteres o más. Si no se pone, se deriva de
# DATABASE_URL. Si se cambia, se cierran todas las sesiones abiertas.
ADMIN_SESSION_SECRET=
# Opcional: protege /api/keepalive (la llamada diaria que evita que Supabase "duerma" la base de datos gratuita).
CRON_SECRET=
